* {
    background-color: #040400;
    text-color: #D4D4D4;
    font: "Iosevka KG Terminal 11";
}

window {
    location: north;
    anchor: north;
    width: 100%;
    height: 25em; /* Fixed height */
    padding: 4px;
    border: 0px;
}

mainbox {
    orientation: vertical;
    children: [ inputbar, listview ];
    spacing: 0px;
}

inputbar {
    orientation: horizontal;
    children: [ prompt, entry ];
    padding: 8px 8px;
    background-color: #040400;
}

prompt {
    padding: 0px 8px 0px 0px;
}

entry {
    expand: true;
}

listview {
    layout: vertical;
    spacing: 1px;
    fixed-height: true;
}

element {
    padding: 5px 8px;
}

element selected {
    background-color: #202018;
    text-color: #FFFFFF;
}

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
}
