{
  "icon_theme": "Colored Zed Icons Theme Dark",
  "hover_popover_enabled": false,
  "use_on_type_format": false,
  "scrollbar": {
    "show": "system",
  },
  // "icon_theme": "Colored Zed Icons Theme Light",
  "disable_ai": true,
  "bottom_dock_layout": "full",
  "current_line_highlight": "line",
  "confirm_quit": true,
  "wrap_guides": [100],
  "show_wrap_guides": true,
  "code_lens": "menu",
  "vim_mode": true,
  "collaboration_panel": {
    "button": false,
  },
  "file_finder": {
    "modal_max_width": "small",
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "soft_wrap": "editor_width",
  "agent_buffer_font_size": 17,
  "agent_ui_font_size": 17,
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
  },
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": true,
    },
  },
  "window_decorations": "server",
  "title_bar": {
    "open_menus_on_hover": true,
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_branch_name": false,
    "show_menus": false,
    "show_branch_status_icon": false,
    "button_layout": "standard",
    "show_user_menu": true,
    "show_worktree_name": true,
    "show_user_picture": false,
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show": true,
  },
  "status_bar": {
    "show_active_file": true,
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": false,
  },
  "minimap": {},
  "auto_update": false,
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "indent_guides": {
      "show": "never",
    },
    "indent_size": 18,
    "auto_fold_dirs": false,
    "dock": "left",
  },
  "buffer_line_height": {
    "custom": 1.2
  },
  "gutter": {
    "line_numbers": true,
    "min_line_number_digits": 0,
  },
  "relative_line_numbers": "enabled",
  "vim": {
    "cursor_shape": {},
    "highlight_on_yank_duration": 100,
  },
  "show_whitespaces": null,
  "whitespace_map": {
    "space": ".",
    "tab": ".",
  },
  "indent_guides": {
    "active_line_width": 1,
    "enabled": true,
    "line_width": 0,
  },

  "outline_panel": {
    "dock": "right",
  },

  // "buffer_font_family": "NotoMono Nerd Font Mono",
  "buffer_font_family": "Hack Nerd Font",
  "buffer_font_features": {
    "calt": true,
    "liga": true,
  },
  "text_rendering_mode": "subpixel",
  "buffer_font_weight": 400,
  "ui_font_weight": 500,
  "ui_font_family": "NotoMono Nerd Font Mono",
  // "ui_font_family": "RobotoMono Nerd Font",
  "buffer_font_size": 16,
  "ui_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Vim Dark",
  },
  "unstable.ui_density": "compact",
  "toolbar": {
    "agent_review": false,
    "breadcrumbs": true,
    "code_actions": false,
    "quick_actions": false,
    "selections_menu": false,
  },
  "lsp": {
    "clangd": {
      "binary": {
        "path": "/usr/bin/clangd",
      },
    },
    "zls": {
      "binary": {
        "path": "/home/cozzycode/.local/share/mise/installs/zls/latest/zls",
      },
    },
    // "typescript-ls": {
    //    "binary": {
    //       "path": "/home/cozzycode/.local/share/mise/installs/node/24.18.0/bin/tsc",
    //       "arguments": ["--lsp", "--stdio"],
    //    },
    // },
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": true,
        "procMacro": {
          "enable": true,
        },
        "cargo": {
          "runBuildScripts": false,
        },
        "workspace": {
          "discoverConfiguredRoles": false,
        },
        "completion": {
          "callable": {
            "snippets": "none",
          },
          "postfix": {
            "enable": false,
          },
        },
      },
    },
  },
  "languages": {
    "C": {
      "language_servers": ["clangd"],
    },
    "C++": {
      "language_servers": ["clangd"],
    },
    "JSON": {
      "formatter": "language_server",
    },
    "Zig": {
      "tab_size": 4,
      "inlay_hints": {
        "enabled": false,
        "show_type_hints": true,
      },
    },
    "TypeScript": {
      "language_servers": ["typescript-ls"],
      // "language_servers": [""],
      "tab_size": 2,
      "formatter": "language_server",
      "inlay_hints": {
        "enabled": false,
        "show_other_hints": false,
        "show_type_hints": false,
        "show_background": true,
        "show_parameter_hints": true,
      },
    },
    "Rust": {
      // "language_servers": [""],
      "inlay_hints": {
        "enabled": false,
        "show_value_hints": false,
      },
      "tab_size": 4,
    },
    "Go": {
      "tab_size": 3,
      "inlay_hints": {
        "show_background": false,
        "enabled": false,
      },
    },
    "TSX": {
      "language_servers": ["typescript-ls"],
      // "language_servers": [""],
      "tab_size": 2,
      "formatter": "language_server",
      "inlay_hints": {
        "enabled": true,
        "show_other_hints": false,
        "show_type_hints": false,
        "show_background": true,
        "show_parameter_hints": false,
        "show_value_hints": true,
      },
    },
  },

  "terminal": {
    // "font_family": "Maple Mono NF",
    "font_size": 15,
    "font_weight": 300,
    "dock": "bottom",
    "toolbar": {
      // "breadcrumbs": false,
    },
  },
  "inlay_hints": {
    "enabled": false,
    "show_background": true,
    // "toggle_on_modifiers_press": {
    //    "control": true,
    //    "shift": false,
    //    "alt": false,
    // },
  },
  "tab_size": 2,
  "hard_tabs": false,
  // "auto_indent": "syntax_aware",
  "experimental.theme_overrides": {
